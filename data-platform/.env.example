# Copy to .env and edit. .env is git-ignored and must never be committed.
# Everything here is machine-specific; nothing here changes behaviour that code
# should own. Spoke and hub differ only through these values plus the matching
# Meltano environment and SQLMesh gateway.

# ---------------------------------------------------------------------------
# Node identity
# ---------------------------------------------------------------------------
# spoke (default) or hub. Selects the Meltano environment and, by default, the
# SQLMesh gateway of the same name. It never selects different code.
PLATFORM_NODE_ROLE=spoke

# Override only if you want a gateway whose name differs from the node role.
# SQLMESH_GATEWAY=spoke

# ---------------------------------------------------------------------------
# Data plane
# ---------------------------------------------------------------------------
# Where the data plane lives. Relative paths resolve against the project root.
# PLATFORM_DATA_DIR=data

# local_only (default) keeps everything on this disk and makes `make sync` an
# explicit no-op. Set an s3:// URI to enable DVC-backed sync; `uv add dvc[s3]`
# is required before that will work.
DATA_REMOTE=local_only

# Credentials for the data remote. Required only when DATA_REMOTE is an s3 URI.
# Never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# ---------------------------------------------------------------------------
# Official-source fetching (pipeline/fetch_law.py) -- OPERATOR TOOL, optional
# ---------------------------------------------------------------------------
# Only needed if you use `python -m pipeline.fetch_law` to pull official docs
# into data/inbox/documents/. Both keys are free and neither is used by the
# build or the read path. Never commit real values.
#
# 법제처 국가법령정보 OPEN API (law.go.kr/DRF): register at open.law.go.kr
# (email verification only). OC is your registered id, not literally "test".
# LAW_OC=
#
# 국회 열린국회정보 OPEN API (open.assembly.go.kr): register and issue an 인증키.
# ASSEMBLY_API_KEY=
#
# DART 전자공시 OPEN API (opendart.fss.or.kr): register, a personal crtfc_key is
# issued instantly. Used by `fetch_law dart` (증권신고서, e.g. 투자계약증권/조각투자).
# DART_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# hashing (default) is deterministic, local, and needs no model download, so the
# build never blocks on the network. It handles Korean via character n-grams:
# measured on Korean legal/government retrieval it lands close to a dense
# multilingual model ONCE FUSED with the keyword half, because statute queries
# reuse the statute's own vocabulary.
#
# What it cannot do is context or genuine synonymy: it is a bag of character
# n-grams, so word order and 조사/어미 disambiguation are invisible to it, and it
# will not match 원화 to 금전. For a CONTEXT-preserving upgrade, use the
# int8-quantised bge-m3 ONNX encoder: a real transformer (self-attention intact)
# that runs torch-free on CPU via onnxruntime. The model is ~568 MB, fetched once
# into the local cache, and query encoding is ~11 ms, so the read path stays
# offline and cheap:
#
#   uv sync --extra onnx-embed
#   EMBEDDING_PROVIDER=onnx_int8
#   EMBEDDING_MODEL=Xenova/bge-m3      # int8 ONNX; torch-free; ~568 MB, cached once
#
# Measured on the committed Korean bill eval (`make eval`), onnx_int8 vs hashing:
# the vector arm MRR@10 rises 0.469 -> 0.738 and the fused MRR@10 0.699 -> 0.744,
# with particle-glued queries reaching 1.000. It does NOT close the synonymy gap
# (0.444, unchanged) -- that is pipeline/aliases.tsv's job, not the embedder's.
# The index build re-encodes every chunk single-threaded for bit-stable rebuilds
# (~10 min for ~1200 chunks); the DEFAULT stays hashing so `make build` never
# needs a model. For any other Sentence-Transformers model (needs torch, ~2.2 GB):
#
#   uv add sentence-transformers
#   EMBEDDING_PROVIDER=sentence_transformers
#   EMBEDDING_MODEL=BAAI/bge-m3        # strong Korean; ~2.2 GB of weights + torch
#
# Changing any of these changes index_signature, so the next query fails loudly
# until you run `make build`. That is deliberate.
EMBEDDING_PROVIDER=hashing
# 1024 is the measured knee for Korean. Below 512 the hashing provider refuses
# to start: Korean character n-grams collide badly in a small vector.
EMBEDDING_DIM=1024
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reciprocal rank fusion constant. Larger values flatten the contribution of top
# ranks, which helps when one retrieval half is much noisier than the other.
RRF_K=60

# The two arms are not equally trustworthy on Korean: the keyword half matches
# statute vocabulary exactly, the vector half is a bag of character n-grams.
# Measured on 45 Korean queries, weighting the vector arm at 0.3 lifts MRR@10
# from 0.706 to 0.725 and takes particle-glued queries to 1.000. Flat across
# 0.3-0.5, so there is no knife-edge. Do NOT set it to 0: dropping the arm
# breaks exact-identifier retrieval.
VECTOR_WEIGHT=0.3
KEYWORD_WEIGHT=1.0

# Query-side domain synonym expansion (pipeline/aliases.tsv). Bridges
# 스테이블코인 to 자산연동형, which share no characters and are therefore
# invisible to both halves of the index. Query-time only: turning it off needs
# no rebuild. Measured MRR@10 0.725 -> 0.802, at 8.7 ms/query against 4.5 ms.
ALIAS_EXPANSION=1
