# 26bmdc — root ignore. data-platform/ keeps its own nested .gitignore
# (data/, .venv/, .meltano/, .env …), which git still honours inside this repo.

# OS / editor
.DS_Store
*.swp
*~

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Node / Scaffold-ETH 2 dApp builds generated under gen-apps/
node_modules/
gen-apps/**/.next/
gen-apps/**/cache/
gen-apps/**/out/
gen-apps/**/artifacts/
gen-apps/**/broadcast/
gen-apps/**/*.log

# GENERATION OUTPUTS ARE NOT DISTRIBUTED. Only the skills, prompts, and tools that
# PRODUCE them are tracked (gen-docs/st_prospectus/{sto-filing,prompt-templates,
# build_prompts.py,PACKAGING.md}, gen-apps/{st-service-dapp,filing-to-dapp,
# ST_SERVICE_DAPP_PROMPT.md}). Everything a run emits — an issuer's 증권신고서 draft
# or a generated dApp service, plus the eval workspaces — stays local.
#   - per-issuer output folders (energyasset-gas-station-1, <issuer>-<asset>-N/)
#   - eval/run workspaces (*-workspace/)
#   - assembled prompts under dist/ (regenerated from source by build_prompts.py)
# These are matched by explicit patterns rather than a blanket gen-*/*/ so a NEW
# skill folder is never accidentally hidden. Add a new output folder's pattern here.
gen-docs/**/dist/
gen-docs/st_prospectus/*-workspace/
gen-docs/st_prospectus/energyasset-gas-station-1/
gen-apps/*-workspace/
gen-apps/energyasset-gas-station-1/

# Auto-installed browser binaries (Playwright / Scrapling, used by fetch_web.py)
.cache/ms-playwright/
.cache/scrapling/

# Secrets (per-tree .env; .env.example stays tracked)
.env
.env.*
!.env.example

# Local-only design/working notes — preserved on disk but never shared.
# (docs/*.svg diagrams stay tracked; only this subfolder is ignored.)
docs/design/

# Vendor adapter directories — GENERATED, never committed. `.agents/skills/` is the
# canon and the only tracked copy; `.claude/skills/` is the path Claude Code happens
# to read, holding no content of its own. Tracking it cost two things: a vendor name
# in version control, and a Windows trap — a `core.symlinks=false` clone turns each
# link into a text file holding a path, and the skills then fail to load with no
# error. So it is built locally instead: `make skills`, once per clone, exactly like
# `make hooks`. `make check` verifies it whenever it exists.
.claude/skills/
# Claude Code — local workspace settings, kept per-machine (plugin enablement).
.claude/settings.json
